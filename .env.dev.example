# Global login page (all roles start here)
BASE_URL=https://dev.partscheck.com.au/global/login.php

# --- Repairer (same username; password decides normal vs admin) ---
REPAIRER_USERNAME=your-repairer-username
REPAIRER_PASSWORD=your-repairer-normal-password
REPAIRER_ADMIN_PASSWORD=your-repairer-admin-password

# --- Supplier (same username; password decides normal vs admin) ---
SUPPLIER_USERNAME=your-supplier-username
SUPPLIER_PASSWORD=your-supplier-normal-password
SUPPLIER_ADMIN_PASSWORD=your-supplier-admin-password

# --- Post-login landing URLs (asserted after sign-in) ---
REPAIRER_LANDING_URL=https://v2.dev.partscheck.com.au/appV2/welcome.php
SUPPLIER_LANDING_URL=https://v1.dev.partscheck.com.au/app/dashboard.php

# --- Fingerprint / device-confirmation test users (picked in the popup) ---
REPAIRER_FINGERPRINT_USER=Test User
SUPPLIER_FINGERPRINT_USER=Matt Matt
